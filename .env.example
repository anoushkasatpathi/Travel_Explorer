# Copy this file to ".env", fill in your keys, then restart with:  npx expo start -c
# Every key is optional: anything left as a placeholder just turns that feature
# back to its offline / backup behaviour. Never commit your real .env file.

# --- Weather: OpenWeather (https://home.openweathermap.org/api_keys) ---
# New keys can take up to a couple of hours to become active.
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Currency: ExchangeRate-API (https://www.exchangerate-api.com, free plan) ---
EXPO_PUBLIC_EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# --- Firebase (Auth + Firestore) ---
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration → Config
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
